# Variables para Backend Spring Boot (arranque manual con ./mvnw spring-boot:run)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reto_room_911
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# OBLIGATORIA: sin JWT_SECRET el backend no arranca (minimo 32 caracteres aleatorios)
JWT_SECRET=cambiar-por-un-secret-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=28800000

# OBLIGATORIA: API key de la superficie publica /api/acceso (lectores y simulador)
ACCESO_API_KEY=cambiar-por-una-apikey-aleatoria-de-al-menos-32-caracteres

# Origenes CORS permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

ROOM911_SEED_PASSWORD=
ROOM911_SYNC_SEED_PASSWORD=false
