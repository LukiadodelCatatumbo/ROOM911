# URL base de la API REST del backend.
# - Desarrollo local con `pnpm dev`: http://localhost:8080/api (o el proxy /api de vite.config).
# - Docker Compose (nginx proxifica /api al backend): usa /api.
# Esta diferencia es intencional; el Dockerfile inyecta su propio valor via build ARG.
VITE_API_URL=http://localhost:8080/api

# API key del backend para la superficie publica /api/acceso (lectores y simulador).
# Debe coincidir con ACCESO_API_KEY definida en el .env raiz / docker-compose.
VITE_ACCESO_API_KEY=

# Credenciales demo del login (dejar vacio oculta el panel de demostracion)
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=
VITE_SESSION_TIMEOUT_MINUTES=15
VITE_SESSION_WARNING_MINUTES=1
