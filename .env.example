# ==========================================
# ROOM911 - Variables de Entorno Globales
# ==========================================

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reto_room_911
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
# Puerto de la BD publicado en el host (solo localhost) para pgAdmin/DBeaver.
# Cambialo si el 5432 ya esta ocupado por un postgres nativo.
DB_HOST_PORT=5432

# Backend Spring Boot
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Seguridad JWT (OBLIGATORIO definir JWT_SECRET en produccion: 32+ caracteres aleatorios)
JWT_SECRET=cambiar-por-un-secret-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=28800000

# CORS: origenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Contrasena inicial de los administradores sembrados por DataInitializer
# (si se deja vacia, se genera una aleatoria y se registra en el log del backend)
ROOM911_SEED_PASSWORD=
ROOM911_SYNC_SEED_PASSWORD=false

# Frontend Vite
VITE_API_URL=/api
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=
VITE_SESSION_TIMEOUT_MINUTES=15
VITE_SESSION_WARNING_MINUTES=1
PORT=5173
